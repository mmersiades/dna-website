{
  "name": "dna-website",
  "version": "0.8.4",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sanity:predev": "pnpm run typegen",
    "sanity:prebuild": "pnpm run typegen",
    "sanity:typegen": "sanity schema extract --enforce-required-fields --path=./src/sanity/extract.json && sanity typegen generate",
    "prettier:write": "npx prettier . --write",
    "prettier:check": "npx prettier . --check",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "test": "vitest --project=node",
    "test:coverage": "vitest --project=node --coverage --run",
    "build-storybook": "storybook build",
    "test-storybook": "vitest --project=storybook",
    "test-storybook:coverage": "vitest --project=storybook --coverage --run",
    "chromatic": "npx chromatic"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@hookform/resolvers": "^5.9.1",
    "@iconify/json": "^2.2.520",
    "@iconify/tailwind4": "^1.2.3",
    "@oddbird/popover-polyfill": "^0.6.1",
    "@react-pdf/renderer": "^4.8.1",
    "@sanity/client": "^7.26.2",
    "@sanity/icons": "^3.8.0",
    "@sanity/image-url": "^1.2.0",
    "@sanity/vision": "^4.22.1",
    "@sentry/nextjs": "^10.71.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "botid": "^1.5.11",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "googleapis": "^171.4.0",
    "html-react-parser": "^5.2.17",
    "next": "^16.3.3",
    "next-sanity": "^11.6.13",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.13",
    "pino": "^10.3.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-toastify": "^11.1.0",
    "sanity": "^4.22.1",
    "schema-dts": "^1.1.5",
    "styled-components": "^6.5.3",
    "tailwind-merge": "^3.6.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-themes": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/nextjs-vite": "^10.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^7.0.12",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "chromatic": "^18.6.0",
    "domhandler": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "eslint-plugin-storybook": "^10.5.10",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^2.0.7",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-hook-form": "^7.86.0",
    "storybook": "^10.5.10",
    "storybook-addon-pseudo-states": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --cache --fix",
    "*.{js,jsx,ts,tsx,json}": "prettier --write"
  },
  "peerDependencies": {
    "react-hook-form": "^7.71.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
